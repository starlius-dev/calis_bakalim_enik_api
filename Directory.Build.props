<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Single source of truth for the product version. See docs/VERSIONING.md §2. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- Bumped and committed by deploy/publish-api.sh on every qa publish;
         prod ships the number qa tested. Never hand-edited. -->
    <DefaultBuildNumber>9</DefaultBuildNumber>
    <BuildNumber Condition="'$(BuildNumber)' == ''">$(DefaultBuildNumber)</BuildNumber>
    <GitSha Condition="'$(GitSha)' == ''">local</GitSha>
    <InformationalVersion>$(VersionPrefix)+$(BuildNumber).$(GitSha)</InformationalVersion>
    <!-- SourceLink otherwise appends "+<sha>" again, producing 0.1.0+0.local.<sha>. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Çalış Bakalım Enik</Product>
    <Company>Starlius</Company>
  </PropertyGroup>

</Project>
