# /var/www/calis_bakalim_enik_api/qa/calis_bakalim_enik_api.env
#
#   install -o root -g servrinuse -m 0600 calis_bakalim_enik_api.env.example \
#           /var/www/calis_bakalim_enik_api/qa/calis_bakalim_enik_api.env
#
# Copy, fill in, chmod 600. Never commit the filled-in version.
#
# Double underscore is .NET's separator for a nested key: Redis__Database is
# Redis:Database. systemd reads this file literally — no quotes, no expansion,
# no inline comments after a value.

# ── refuses to start without these two ───────────────────────────────

# The API throws at startup rather than run with the logging mailer, because a
# deployment where every confirmation link lands in a local file looks healthy
# and nobody can finish signing up.
Email__Provider=Resend
Email__ApiKey=

# WHERE THE LINKS IN THE MAIL POINT. Defaults to https://calisbakalimenik.app —
# production — so leaving it unset on the QA slot sends testers a confirmation
# link to a site that does not exist. No trailing slash. Must match the address
# the testers actually open.
Email__AppBaseUrl=https://test.calisbakalimenik.app

# What the recipient sees in their inbox. The display name shows; the address
# shows only if they look. The local part is free and needs no real mailbox.
#
# The DOMAIN must be EXACTLY one that is verified in Resend. A verified
# subdomain does not verify its parent: business-application.starlius.com being
# verified says nothing about starlius.com, because the DKIM and SPF records
# sit on the subdomain. Sending from the parent is refused with 403, and that
# is the usual reason a first send fails.
#
# The code default is <hesap@calisbakalimenik.app>, which is NOT verified yet —
# so this line is not optional today.
Email__From=Çalış Bakalım Enik <calis-bakalim-enik@business-application.starlius.com>

# Worth setting. Nothing receives mail at the From address, so a tester who hits
# reply is talking to a black hole. Point this at an inbox somebody reads.
# Email__ReplyTo=destek@business-application.starlius.com

# And throws without this, because without a persisted key ring every restart
# invalidates every TOTP secret in the database: the service looks fine while
# rejecting every correct authenticator code. Must be on durable storage and
# must be backed up with the database.
DataProtection__KeyPath=/var/www/calis_bakalim_enik_api/files/keys

# ── data ─────────────────────────────────────────────────────────────

# The APP role, which cannot change the schema. Migrations run as
# calis_bakalim_enik_qa_migrations, from the deploy script, never from here.
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=calis_bakalim_enik_qa;Username=calis_bakalim_enik_qa_app;Password=

# db 1 = prod, db 2 = qa, db 3 = local development. One Redis instance is shared
# with other projects on this box, so the database number is the only thing
# keeping them apart — the cbe: prefix is a readability aid, not isolation.
Redis__Configuration=127.0.0.1:6379
Redis__Database=2
Redis__KeyPrefix=cbe:

# ── who is allowed to say where a request came from ──────────────────

# Leave EMPTY to use Cloudflare's published ranges, which is what you want.
# Loopback is added automatically and must be: cloudflared runs on this host and
# connects over 127.0.0.1, which is not in Cloudflare's list, and without it
# every user collapses into one rate-limit bucket.
#
# Setting this REPLACES the published ranges rather than adding to them.
# Cloudflare__TrustedNetworks__0=203.0.113.0/24

# ── the browser origins allowed to call this API ─────────────────────

# Without at least one entry every request from the web app fails CORS. No
# trailing slash. This is the single most likely thing to be wrong on first
# deploy, and the symptom is a blank app with console errors rather than
# anything in the API log.
Cors__AllowedOrigins__0=https://test.calisbakalimenik.app

# ── tokens ───────────────────────────────────────────────────────────

Jwt__Issuer=https://api-qa.calisbakalimenik.app
Jwt__Audience=calisbakalimenik.app

# ── the client version gate ──────────────────────────────────────────

# Empty means no gate, which is the right default: a floor that turns itself on
# locks every tester out of a working app on a routine deploy. Set it only when
# you have decided an old build genuinely cannot be served.
# Client__MinimumVersion=1.4.0
# Client__StoreUrl=https://calisbakalimenik.app/indir

# ── the first administrator ──────────────────────────────────────────

# Promoted to PlatformAdmin on startup if the account exists. Set it for the
# first deploy, then remove it — it is a bootstrap, not a permanent setting.
# Admin__BootstrapEmail=
