# /etc/systemd/system/qa_calis_bakalim_enik.service
#
# For reading. The live file is written by deploy/server/install-enik-isolation.sh
# (write_unit), which is the source of truth; prod is the same with qa -> prod
# and 3011 -> 3010.
#
# Since October 2026 the API runs as its own system user `enik` (I56), from a
# release folder that /var/www/calis_bakalim_enik_api/qa points at (H54), with
# its settings in /etc/calis_bakalim_enik/qa/api.env (root 0600, read by
# systemd before it drops to enik). Do not loosen the hardening block.

[Unit]
Description=Calis Bakalim Enik API (qa)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=enik
Group=enik
# A symlink to the live release; enik-deploy switches it in one rename.
# Kestrel does not send sd_notify, so Type=notify would hold the unit in
# "activating" until the timeout and kill a healthy service.
ExecStart=/var/www/calis_bakalim_enik_api/qa/CalisBakalimEnik.Api
WorkingDirectory=/var/www/calis_bakalim_enik_api/qa
Restart=always
RestartSec=5
EnvironmentFile=/etc/calis_bakalim_enik/qa/api.env
# Loopback only: nothing but nginx reaches this service.
Environment=ASPNETCORE_URLS=http://127.0.0.1:3011
# Production even in the QA slot, deliberately: it turns on the Cloudflare
# trust list and the start-up guards that refuse a logging-only mailer and an
# unpersisted key ring.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PrintTelemetryMessage=false
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=true
ProtectHome=true
ReadOnlyPaths=/
# The only writable path: the Data Protection key ring (losing it locks out
# every MFA user), the JWT signing key and logs. Owned by enik.
ReadWritePaths=/var/www/calis_bakalim_enik_api/files/qa
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
