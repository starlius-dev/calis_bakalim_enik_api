{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Redis": {
    "Configuration": "",
    "Database": 1,
    "KeyPrefix": "cbe:"
  },
  "Jwt": {
    "Issuer": "https://api.calisbakalimenik.app",
    "Audience": "calisbakalimenik.app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshTokenAbsoluteCapDays": 90
  },
  "Cloudflare": {
    "TrustedNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
